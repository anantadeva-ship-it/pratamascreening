//@version=6
indicator("Intraday VWAP Breakout Alerts", overlay = true)

// Use on a 5-minute chart. The 15-minute EMA filter provides higher-timeframe bias.
// Signals are alerts for review, not broker orders or guaranteed trade recommendations.

string sessionInput = input.session("0930-1550", "Signal session (exchange time)")
bool allowShort = input.bool(false, "Enable short alerts (only if your account/instrument allows)")
int trendLength = input.int(50, "15m trend EMA", minval = 2)
int triggerLength = input.int(20, "5m trigger EMA", minval = 2)
int volumeLength = input.int(20, "Volume average", minval = 2)
float minRelativeVolume = input.float(1.2, "Minimum relative volume", minval = 0.1, step = 0.1)
int stopLookback = input.int(5, "Stop structure lookback", minval = 2)
float rewardRisk1 = input.float(1.0, "Target 1 (R)", minval = 0.5, step = 0.25)
float rewardRisk2 = input.float(2.0, "Target 2 (R)", minval = 1.0, step = 0.25)
float maxVwapDistanceAtr = input.float(1.5, "Max distance from VWAP (ATR)", minval = 0.2, step = 0.1)
float maxAtrPercent = input.float(3.0, "Max ATR as % of price", minval = 0.1, step = 0.1)

bool isFiveMinute = timeframe.isminutes and timeframe.multiplier == 5
bool inSession = not na(time(timeframe.period, sessionInput))
float ema5 = ta.ema(close, triggerLength)
float vwapValue = ta.vwap(hlc3)
float atr = ta.atr(14)
float relativeVolume = volume / ta.sma(volume, volumeLength)
float ema15 = request.security(syminfo.tickerid, "15", ta.ema(close, trendLength), barmerge.gaps_off, barmerge.lookahead_off)
float close15 = request.security(syminfo.tickerid, "15", close, barmerge.gaps_off, barmerge.lookahead_off)

bool volOk = not na(relativeVolume) and relativeVolume >= minRelativeVolume
bool volatilityOk = not na(atr) and close > 0 and atr / close * 100 <= maxAtrPercent
bool notChasing = not na(vwapValue) and math.abs(close - vwapValue) <= atr * maxVwapDistanceAtr
bool commonOk = isFiveMinute and inSession and barstate.isconfirmed and volOk and volatilityOk and notChasing
bool longSignal = commonOk and close15 > ema15 and close > ema5 and close > vwapValue and close > high[1]
bool shortSignal = allowShort and commonOk and close15 < ema15 and close < ema5 and close < vwapValue and close < low[1]

float longStop = ta.lowest(low, stopLookback)
float longRisk = close - longStop
float shortStop = ta.highest(high, stopLookback)
float shortRisk = shortStop - close

plot(ema5, "5m EMA", color = color.orange)
plot(vwapValue, "VWAP", color = color.blue, linewidth = 2)
plotshape(longSignal, "Long alert", shape.triangleup, location.belowbar, color.lime, size = size.tiny, text = "L")
plotshape(shortSignal, "Short alert", shape.triangledown, location.abovebar, color.red, size = size.tiny, text = "S")
plotchar(not isFiveMinute, "Use 5-minute chart", "⚠", location.top, color.orange, size = size.tiny)

if longSignal and longRisk > syminfo.mintick
    float t1 = close + longRisk * rewardRisk1
    float t2 = close + longRisk * rewardRisk2
    string payload = '{"source":"tradingview","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","side":"LONG","setup":"15m trend + 5m VWAP breakout","status":"bar_closed","price":' + str.tostring(close, format.mintick) + ',"stop":' + str.tostring(longStop, format.mintick) + ',"target1":' + str.tostring(t1, format.mintick) + ',"target2":' + str.tostring(t2, format.mintick) + ',"bar_time":' + str.tostring(time_close) + '}'
    alert(payload, alert.freq_once_per_bar_close)

if shortSignal and shortRisk > syminfo.mintick
    float t1 = close - shortRisk * rewardRisk1
    float t2 = close - shortRisk * rewardRisk2
    string payload = '{"source":"tradingview","symbol":"' + syminfo.tickerid + '","timeframe":"' + timeframe.period + '","side":"SHORT","setup":"15m trend + 5m VWAP breakdown","status":"bar_closed","price":' + str.tostring(close, format.mintick) + ',"stop":' + str.tostring(shortStop, format.mintick) + ',"target1":' + str.tostring(t1, format.mintick) + ',"target2":' + str.tostring(t2, format.mintick) + ',"bar_time":' + str.tostring(time_close) + '}'
    alert(payload, alert.freq_once_per_bar_close)

